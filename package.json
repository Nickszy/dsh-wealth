{
  "name": "dsh-wealth",
  "version": "0.1.0",
  "description": "资产账本：多账户、多资产、多币种持仓与交易流水管理，支持对话维护与本机持久化 | Multi-account, multi-asset, multi-currency portfolio & trade ledger for DeepSeek Harness, with chat-based maintenance.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "store.mjs", "cli.mjs", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "portfolio", "ledger", "assets", "投资", "持仓", "记账"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Nickszy/dsh-wealth.git" },
  "homepage": "https://github.com/Nickszy/dsh-wealth#readme",
  "bugs": { "url": "https://github.com/Nickszy/dsh-wealth/issues" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": { "node": ">=20" }
}
